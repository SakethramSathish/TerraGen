# =====================================================================================
# CAT Smart Operator Assistant - example environment file
# -------------------------------------------------------------------------------------
# Copy to `.env` (which is git-ignored) and edit locally:
#
#     cp .env.example .env
#
# NEVER commit a real key. Never paste a key into app.py, a notebook or a chat message.
# The application reads keys in exactly one place:
#   core/llm_gateway.load_llm_settings()  ->  st.secrets first, then this environment.
#
# All variables are OPTIONAL. With no .env at all the app runs in fully offline mode using
# the reviewed, deterministic knowledge base (recommended for edge/air-gapped machines).
# =====================================================================================

# --- Copilot mode --------------------------------------------------------------------
# offline (default, deterministic knowledge base, no network) | remote (OpenAI-compatible)
CAT_COPILOT_MODE=offline

# --- Remote LLM settings (only used when CAT_COPILOT_MODE=remote) --------------------
# Provider label; one of: openai, openai-compatible, azure-openai, local-openai,
# ollama, vllm. Any OpenAI-compatible /chat/completions endpoint works.
CAT_LLM_PROVIDER=openai

# Model name as the provider expects it.
CAT_LLM_MODEL=gpt-4o-mini

# API key. Leave empty for offline mode. Locally hosted (Ollama / vLLM) servers usually
# accept a placeholder such as "not-needed".
CAT_LLM_API_KEY=

# Chat-completions endpoint. Point this at a local inference server to stay on-premises,
# e.g. http://127.0.0.1:11434/v1/chat/completions for Ollama.
CAT_LLM_BASE_URL=https://api.openai.com/v1/chat/completions

# --- Diagnostics ---------------------------------------------------------------------
# 1 = render the extra audit detail (sanitisation log, gate decisions) in the UI.
CAT_DEBUG_AUDIT=0
