# =====================================================================================
# CAT Smart Operator Assistant - Streamlit secrets template
# -------------------------------------------------------------------------------------
# Copy to `.streamlit/secrets.toml` (git-ignored) if you prefer Streamlit's secrets store
# over a .env file:
#
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#     chmod 600 .streamlit/secrets.toml
#
# Precedence at run time:  st.secrets  >  environment variables  >  .env  >  defaults.
# The key is only ever displayed redacted (e.g. `sk-…9f2a`), and it is never written to
# the audit log.
#
# Without this file the app still runs - it simply stays in offline (knowledge-base) mode.
# =====================================================================================

CAT_COPILOT_MODE = "offline"          # "offline" (default) or "remote"
CAT_LLM_PROVIDER = "openai"           # openai | openai-compatible | azure-openai | ollama | vllm
CAT_LLM_MODEL    = "gpt-4o-mini"
CAT_LLM_API_KEY  = ""                 # <-- put the real key ONLY here (never in code)
CAT_LLM_BASE_URL = "https://api.openai.com/v1/chat/completions"

# Diagnostics: render the sanitisation / gate-decision detail in the Security tab.
CAT_DEBUG_AUDIT = false
